# Copy this file to .env and change every key before sharing your machine / network.
# .env is git-ignored — NEVER commit real secrets.

# ---- API keys (role-based access control) ----
# admin   : everything + edit detection rules + audit log
# analyst : read dashboards, work alerts (status changes, notes, reports)
# sensor  : may ONLY submit flows (used by the traffic simulator)
IDS_ADMIN_KEY=admin-dev-key-change-me
IDS_ANALYST_KEY=analyst-dev-key-change-me
IDS_SENSOR_KEY=sensor-dev-key-change-me

# ---- Storage ----
IDS_DB_PATH=data/ids.db

# ---- Detection ----
IDS_ML_ENABLED=true              # false -> hybrid uses rules 60% / anomaly 40%
IDS_CORRELATION_WINDOW=60        # seconds; alerts from same source+type are grouped

# ---- API hardening ----
IDS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
IDS_RATE_LIMIT_PER_MINUTE=1200

# ---- SIEM export (newline-delimited JSON a log forwarder could ship) ----
IDS_SIEM_EXPORT_ENABLED=true
IDS_SIEM_EXPORT_PATH=logs/siem_alerts.jsonl
