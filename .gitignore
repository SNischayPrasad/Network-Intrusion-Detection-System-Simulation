#     download them — each user trains their own with `python -m ml.train_model`.
models/*.joblib

# --- Frontend ---
frontend/node_modules/
frontend/dist/

# --- Editors / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db
.claude/
