# --- Secrets ---
.env
*.pem
*.key

# --- Python ---
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/

# --- Runtime data (regenerate locally) ---
data/*.db
data/*.db-wal
data/*.db-shm
logs/*
